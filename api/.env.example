# Copy to .env for local development. In Railway, set these as service
# variables instead — see README.md for exactly which ones and why.

# Public — same value already used in the site's invite link.
DISCORD_CLIENT_ID=1520771362246103091

# Secret — Discord Developer Portal → your app → OAuth2 → Client Secret.
# Never commit a real value here.
DISCORD_CLIENT_SECRET=

# The bot's own token. In Railway this is set as a *reference* to the
# existing bot service's DISCORD_TOKEN variable, so this API never needs
# its own copy of the secret. Locally, use a throwaway/dev bot token.
DISCORD_BOT_TOKEN=

# Must exactly match a redirect URI registered on the Discord app.
# Local dev example: http://localhost:3000/auth/discord/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Where the React app runs. Comma-separate multiple origins if needed.
FRONTEND_URL=http://localhost:5173

# Signs session tokens. Any long random string — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated Discord user IDs allowed into the devs-only dashboard.
DEV_USER_IDS=

# --- Guild configuration ---

# The BOT's cluster. This is where guildConfig and featureManifest live, and
# writing the same documents the bot reads is the whole point — a separate
# copy is not an option, it is the bug this replaced.
#
# Do NOT paste the bot's own connection string here. Create a dedicated Atlas
# database user with a custom role granting:
#     readWrite  on  trh_bot.guildConfig
#     read       on  trh_bot.featureManifest
# and nothing else. This service is internet-facing; the bot's URI would give
# a bug in a config route reach over economyAccounts and every other
# collection.
BOT_MONGODB_URI=
BOT_MONGODB_DB_NAME=trh_bot

# The WEBSITE's own cluster — the config audit trail, and whatever else this
# service owns outright later. The bot never connects to this one.
# mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=alice_website

# Optional. Lets the devs dashboard pull the bot service's recent logs
# straight from Railway. Create a *project* token (not an account token)
# from this project's Settings > Tokens page — it authenticates with the
# Project-Access-Token header rather than a bearer token. Leave all four
# blank to just hide the logs panel; the rest of the dashboard still works.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_BOT_SERVICE_ID=

PORT=3000
